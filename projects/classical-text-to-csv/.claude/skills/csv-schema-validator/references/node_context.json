  "node_id": "csv_generation",
  "node_spec": {
    "node_id": "csv_generation",
    "title": "CSV 文件生成",
    "purpose": "按照标准格式要求生成 CSV 文件，将所有篇章的结构化数据合并、排序、汇总为单个 CSV 文件，确保编码为 UTF-8，分隔符为英文逗号。CSV 包含 16 个字段：著作标题、篇章标题、段落序号、段落内容、译文、注释、名句（留空）、背景（留空）、解析、作者、著作类型、内容分类、朝代、著作简介、篇章类型、创作年份",
    "archetype": "generate-output",
    "depends_on": [
      "chapter_metadata_enrichment"
    ],
    "inputs": [
      {
        "name": "enriched_chapters_dir",
        "from": {
          "kind": "node_output",
          "name": null,
          "node_id": "chapter_metadata_enrichment",
          "output": "enriched_chapters_dir"
        },
        "shape": "directory",
        "required": true,
        "summary": "元数据丰富后的篇章文档目录"
      },
      {
        "name": "metadata_enrichment_manifest",
        "from": {
          "kind": "node_output",
          "name": null,
          "node_id": "chapter_metadata_enrichment",
          "output": "metadata_enrichment_manifest"
        },
        "shape": "structured_data",
        "required": true,
        "summary": "元数据丰富处理清单，用于验证数据完整性"
      },
      {
        "name": "work_title",
        "from": {
          "kind": "workflow_input",
          "name": "work_title",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": true,
        "summary": "著作标题"
      },
      {
        "name": "author",
        "from": {
          "kind": "workflow_input",
          "name": "author",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": false,
        "summary": "作者"
      },
      {
        "name": "work_type",
        "from": {
          "kind": "workflow_input",
          "name": "work_type",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": false,
        "summary": "著作类型"
      },
      {
        "name": "category",
        "from": {
          "kind": "workflow_input",
          "name": "category",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": false,
        "summary": "内容分类"
      },
      {
        "name": "era",
        "from": {
          "kind": "workflow_input",
          "name": "era",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": false,
        "summary": "朝代"
      },
      {
        "name": "description",
        "from": {
          "kind": "workflow_input",
          "name": "description",
          "node_id": null,
          "output": null
        },
        "shape": "string",
        "required": false,
        "summary": "著作简介"
      }
    ],
    "outputs": [
      {
        "name": "csv_file",
        "shape": "file",
        "summary": "生成的标准格式 CSV 文件，包含 16 个字段"
      }
    ],
    "executor": {
      "skill": "classical-csv-generator"
    },
    "validators": [
      {
        "validator_id": "csv-format-check",
        "skill": "csv-format-validator"
      },
      {
        "validator_id": "csv-schema-check",
        "skill": "csv-schema-validator"
      }
    ],
    "acceptance": {
      "done_means": "已生成符合标准格式的 CSV 文件",
      "pass_condition": [
        "CSV 编码为 UTF-8",
        "表头包含所有 16 个字段：著作标题、篇章标题、段落序号、段落内容、译文、注释、名句、背景、解析、作者、著作类型、内容分类、朝代、著作简介、篇章类型、创作年份",
        "分隔符为英文逗号",
        "名句和背景字段已留空",
        "段落序号可正确转为整数",
        "数据行与输入段落一致",
        "各篇章数据完整无遗漏",
        "注释格式为 词语:解释,词语:解释",
        "译文字段不包含占位文本（如「【译文】第 xx 段」）",
        "解析字段不为空且不包含占位文本"
      ]
    },
    "gate": {
      "mode": "all_validators_pass"
    },
    "handoff": {
      "outputs": [
        "csv_file"
      ]
    }
  },
