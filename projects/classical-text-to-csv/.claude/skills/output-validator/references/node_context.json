{
  "workflow": {
    "workflow_id": "classical-text-to-csv",
    "title": "古籍文本整理自动工作流",
    "version": "0.7.0"
  },
  "skill": {
    "name": "output-validator",
    "role": "executor",
    "validator_id": null
  },
  "node_id": "final_validation",
  "node_spec": {
    "node_id": "final_validation",
    "title": "最终质量验证",
    "purpose": "对生成的 CSV 进行全面的质量检查，包括内容完整性验证、格式规范验证、篇章结构验证，重点核查译文和解析字段是否为真实有效内容，并生成处理报告",
    "archetype": "validate-output",
    "depends_on": [
      "csv_generation",
      "chapter_batch_segmentation"
    ],
    "inputs": [
      {
        "name": "csv_file",
        "from": {
          "kind": "node_output",
          "name": null,
          "node_id": "csv_generation",
          "output": "csv_file"
        },
        "shape": "file",
        "required": true,
        "summary": "生成的 CSV 文件"
      },
      {
        "name": "segmentation_manifest",
        "from": {
          "kind": "node_output",
          "name": null,
          "node_id": "chapter_batch_segmentation",
          "output": "segmentation_manifest"
        },
        "shape": "structured_data",
        "required": true,
        "summary": "分段处理清单，用于比对验证"
      }
    ],
    "outputs": [
      {
        "name": "validated_csv",
        "shape": "file",
        "summary": "验证通过的 CSV 文件"
      },
      {
        "name": "report",
        "shape": "file",
        "summary": "处理报告，包含结构识别、切块统计、分段统计和质量检查结果"
      }
    ],
    "executor": {
      "skill": "output-validator"
    },
    "validators": [
      {
        "validator_id": "completeness-check",
        "skill": "completeness-validator"
      },
      {
        "validator_id": "quality-check",
        "skill": "quality-validator"
      }
    ],
    "acceptance": {
      "done_means": "CSV 文件已通过全面质量验证，包括译文和解析内容的真实性核查",
      "pass_condition": [
        "原文内容无遗漏",
        "无错误修改",
        "格式完全符合规范",
        "段落序号连续无重复",
        "元数据完整准确",
        "各篇章结构清晰完整",
        "名句和背景字段已留空",
        "注释格式正确",
        "译文字段不含占位文本（如「【译文】第 xx 段」等格式），且诗词类译文不为空",
        "解析字段均为实质性内容，不为空，不含占位文本"
      ]
    },
    "gate": {
      "mode": "all_validators_pass"
    },
    "handoff": {
      "outputs": [
        "validated_csv",
        "report"
      ]
    }
  },
  "updated_at": "2026-03-27T10:31:01.504640+00:00"
}